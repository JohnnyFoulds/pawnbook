# pawnbook — environment variables
# Copy to .env and adjust. All vars are optional; defaults are shown.

# Server
PORT=3000
BIND_ADDR=127.0.0.1
NODE_ENV=development
LOG_LEVEL=debug

# Engine mode: native (use host binaries) or container (use /usr/local/bin)
ENGINE_MODE=native

# Native engine paths (ENGINE_MODE=native only)
# STOCKFISH_PATH=/opt/homebrew/opt/stockfish/bin/stockfish
# LC0_PATH=/opt/homebrew/Cellar/lc0/0.32.1/libexec/lc0
# DRAWFISH_PATH=

# Data / weights directories
# DATA_DIR=./data
# WEIGHTS_DIR=./weights

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACE_CONSOLE=1
