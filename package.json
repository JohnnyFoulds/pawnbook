{
  "name": "pawnbook",
  "version": "0.1.0",
  "description": "Play chess engines locally, then drill your own mistakes with spaced repetition",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "chess": "./bin/chess.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "journey": "vitest run tests/journey/",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ts-fsrs": "^5.4.1",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "chartscii": "^4.0.3",
    "sparkly": "^6.0.1",
    "terminal-image": "^5.0.1",
    "terminal-kit": "^3.1.4"
  }
}
